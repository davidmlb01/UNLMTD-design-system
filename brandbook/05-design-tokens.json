      },
      "cream": {
        "$value": "#EDE8DC",
        "$type": "color",
        "$description": "UNLMTD Cream — fundo principal claro. Pantone 9183 C."
      }
    },
    "secondary": {
      "terra": {
        "$value": "#C4622D",
        "$type": "color",
        "$description": "Terra — calor brasileiro, cerâmica artesanal. Uso pontual máx 20% da peça."
      },
      "ouro": {
        "$value": "#C8922A",
        "$type": "color",
        "$description": "Ouro Editorial — celebração, premium. Nunca usar junto com Terra."
      },
      "grafite": {
        "$value": "#3D3D3D",
        "$type": "color",
        "$description": "Grafite Médio — elementos funcionais, textos secundários."
      }
    },
    "semantic": {
      "background-dark": { "$value": "{color.primary.black}", "$type": "color" },
      "background-light": { "$value": "{color.primary.cream}", "$type": "color" },
